# Optional. Without this key, LocoBiz still returns deterministic analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Comma-separated frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Translation: choose auto (Google when available, otherwise BHASHINI), google, or bhashini.
TRANSLATION_PROVIDER=auto
# Google Cloud Translation v2 API key. Keep server-side only.
GOOGLE_TRANSLATE_API_KEY=
# Government of India BHASHINI inference key. Keep server-side only.
BHASHINI_INFERENCE_API_KEY=
# Confirm this model supports the language pairs you enable before production use.
BHASHINI_TRANSLATION_SERVICE_ID=ai4bharat/indictrans-v2-all-gpu--t4
